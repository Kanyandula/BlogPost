# Example environment file for NyasaBlog. Production keeps a real `.env`
# in the deploy directory (out of source control). Local development uses
# `settings.ini` (same keys, INI format) — python-decouple reads either.
# Never commit real values.

# Core
SECRET_KEY=<generate via `python -c "import secrets; print(secrets.token_urlsafe(50))"`>
DEBUG=False
SITE_DOMAIN=nyasablog.com
SITE_PROTOCOL=https

# DigitalOcean Spaces (S3-compatible static + media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_LOCATION=

# Email — Postmark via django-anymail (default)
POSTMARK_SERVER_TOKEN=<obtain from Postmark UI; never commit a real value>
DEFAULT_FROM_EMAIL=NyasaBlog <hello@nyasablog.com>
SUPPORT_EMAIL=hello@nyasablog.com

# Email — emergency rollback to Gmail SMTP. Uncomment EMAIL_BACKEND and the
# SMTP block to flip transport without redeploying code.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
